FLASK_APP=run.py
FLASK_DEBUG=1

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

# Local dev can use SQLite; production should use Postgres
DATABASE_URL=sqlite:///konvoy.db
# DATABASE_URL=postgresql://user:password@localhost:5432/konvoy

CORS_ORIGINS=http://localhost:3000

# console = prints OTPs to the server log (dev only), termii = real SMS
SMS_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=generic

# Set to 1 when running behind Render/Railway/nginx so rate limiting sees real client IPs
BEHIND_PROXY=0
